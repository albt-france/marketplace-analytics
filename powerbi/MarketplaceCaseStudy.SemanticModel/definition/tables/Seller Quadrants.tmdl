	partition 'Seller Quadrants' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "output\seller_quadrants.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"quadrant", type text}, {"sellers", Int64.Type}, {"gmv", type number}, {"orders", Int64.Type}, {"avg_review", type number}, {"late_rate", type number}, {"gmv_share", type number}}, "en-US")
				in
					Typed

