table 'Category Repurchase'
	lineageTag: 739e470e-3139-5776-9ab8-78b2325a2734

	column category
		dataType: string
		lineageTag: 3e305a98-55b2-5af3-a53d-1a100688ccbe
		summarizeBy: none
		sourceColumn: category

	column customers
		dataType: int64
		formatString: #,0
		lineageTag: 45c51ced-1fe2-56d4-96e2-aef47f0aa33b
		summarizeBy: none
		sourceColumn: customers

	column repurchasers
		dataType: int64
		formatString: #,0
		lineageTag: 6465a768-36b0-521f-a8ef-88affc2f38f5
		summarizeBy: none
		sourceColumn: repurchasers

	column repurchase_rate
		dataType: double
		formatString: 0.0%
		lineageTag: 0b522515-b61c-51c7-8a5d-197599f9cbb8
		summarizeBy: none
		sourceColumn: repurchase_rate

	column ci_low
		dataType: double
		formatString: 0.0%
		lineageTag: f3585548-9024-5244-bc2e-d655f3c73940
		summarizeBy: none
		sourceColumn: ci_low

	column ci_high
		dataType: double
		formatString: 0.0%
		lineageTag: 07567321-a76c-56cf-84bd-6fb98ddfc2d8
		summarizeBy: none
		sourceColumn: ci_high

	partition 'Category Repurchase' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "output\category_repurchase.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"category", type text}, {"customers", Int64.Type}, {"repurchasers", Int64.Type}, {"repurchase_rate", type number}, {"ci_low", type number}, {"ci_high", type number}}, "en-US")
				in
					Typed

