	partition Reviews = m
		mode: import
		source =
				let
					Source = Parquet.Document(File.Contents(DataFolder & "clean\reviews.parquet")),
					Selected = Table.SelectColumns(Source, {"review_id", "order_id", "review_score", "review_date", "has_comment"}),
					OrderKeys = Table.RenameColumns(Table.SelectColumns(Orders, {"order_id"}), {{"order_id", "k"}}),
					Joined = Table.Join(Selected, "order_id", OrderKeys, "k", JoinKind.Inner),
					Kept = Table.RemoveColumns(Joined, {"k"}),
					Typed = Table.TransformColumnTypes(Kept, {{"review_id", type text}, {"order_id", type text}, {"review_score", Int64.Type}, {"review_date", type date}, {"has_comment", type logical}})
				in
					Typed

