	partition 'Delivery Stats' = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "output\delivery_stats.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"metric", type text}, {"on_time", type number}, {"late", type number}, {"gap", type number}, {"ci_low", type number}, {"ci_high", type number}, {"p_value", type number}, {"orders_on_time", Int64.Type}, {"orders_late", Int64.Type}, {"on_time_txt", type text}, {"late_txt", type text}, {"gap_txt", type text}, {"ci_txt", type text}, {"p_txt", type text}}, "en-US")
