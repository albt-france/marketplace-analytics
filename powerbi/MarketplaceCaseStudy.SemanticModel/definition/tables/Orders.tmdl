					Source = Parquet.Document(File.Contents(DataFolder & "clean\orders.parquet")),
					Selected = Table.SelectColumns(Source, {"order_id", "customer_unique_id", "customer_state", "order_status", "purchase_date", "is_valid", "items", "item_value", "freight", "gmv", "paid", "main_payment_type", "card_installments", "delivered_date", "estimated_date", "delivery_days", "delay_days", "review_score", "order_seq", "in_window"}),
